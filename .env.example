# Cirquento configuration
# The offline demo needs none of the API keys below.

# --- core ---------------------------------------------------------------
CIRQUENTO_DATABASE_URL=postgresql+asyncpg://cirquento:cirquento@localhost:5432/cirquento
CIRQUENTO_DUCKDB_PATH=./.data/cirquento.duckdb
CIRQUENTO_RULESET=rules/circularity.v3.yaml

# --- classification -----------------------------------------------------
# offline = replay cached responses (deterministic, free, used in CI)
# live    = call the provider below
CIRQUENTO_LLM_MODE=offline
CIRQUENTO_LLM_PROVIDER=openai          # openai | anthropic
CIRQUENTO_LLM_MODEL=gpt-4o-mini
CIRQUENTO_CONFIDENCE_FLOOR=0.72        # below this -> human review queue
CIRQUENTO_MAX_LLM_SPEND_EUR_PER_RUN=25 # hard stop; a runaway loop must not bill
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- passports ----------------------------------------------------------
# Passports are signed so a downstream reader can verify they were not edited.
CIRQUENTO_SIGNING_KEY_PATH=./ops/keys/passport_ed25519.pem
CIRQUENTO_PASSPORT_BASE_URL=https://passports.example.com

# --- observability ------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=cirquento-api
CIRQUENTO_LOG_LEVEL=INFO
